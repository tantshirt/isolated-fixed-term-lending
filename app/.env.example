# Public values are embedded at build time. Rebuild after changing them.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional when a provider has a distinct WebSocket URL.
NEXT_PUBLIC_SOLANA_WS_URL=
NEXT_PUBLIC_LOAN_PROGRAM_ID=CKvMgaAJmtoUN73wDxAKvjYs2d5fcirttjjEjrV9hnef
# Receiver-owned, Full verified SOL/USD shard-0 account (see docs/devnet.md).
PYTH_PRICE_UPDATE_ACCOUNT=
# Server-only Hermes access. Never use NEXT_PUBLIC for this credential.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=
# Only explicit localnet + nonproduction + loopback RPC enables controls.
ENABLE_LOCAL_CONTROLS=false

# Optional dedicated Devnet-only first-draw budget; never reuse the SOAR authority key.
# Requires request_first_scenario from the matching private program release.
PRIVATE_LAB_SPONSOR_SECRET=

# Convex backend (Story 19.2). Set by `npx convex dev` locally and by the Vercel Marketplace integration in deployments.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Convex deployment env is set by `node scripts/connect-providers.mjs --apply` from .env.providers
# (see .env.providers.example). Never put those secrets in Vercel or in NEXT_PUBLIC values.

# Feature switches (public, build time). Each stays off until its provider is connected.
NEXT_PUBLIC_PRIVATE_V2_LIVE=1
NEXT_PUBLIC_TELEGRAM_ENABLED=
NEXT_PUBLIC_MONEYGRAM_ENABLED=
# jitoSOL (test) collateral (Story 26.2): on only with the ZenLo Devnet test mint set and its
# CollateralConfig written through a Squads proposal.
NEXT_PUBLIC_JITOSOL_ENABLED=
NEXT_PUBLIC_JITOSOL_MINT=
NEXT_PUBLIC_MONEYGRAM_ENV=sandbox
