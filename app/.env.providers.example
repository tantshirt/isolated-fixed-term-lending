# Copy to .env.providers (gitignored), fill what you have, then:
#   node scripts/connect-providers.mjs            # dry run: says what is missing and what would be set
#   node scripts/connect-providers.mjs --apply    # sets Convex env, Vercel flags, Telegram webhook
# Anything left blank is skipped, and that provider stays switched off.

# Which Convex deployment to configure (e.g. prod:happy-otter-123). Blank = the one in .env.local.
CONVEX_DEPLOY_TARGET=

# Wallet sign-in (Story 19.2). Generate the key with: node scripts/auth-keygen.mjs
AUTH_JWT_PRIVATE_JWK=
AUTH_ALLOWED_DOMAINS=zenlo.vercel.app
AUTH_NETWORK=devnet

# Operations (Stories 19.3, 24.5): comma-separated ops wallets and the cron report secret.
OPS_ADMIN_WALLETS=
OPS_REPORT_SECRET=

# Telegram alerts (Story 24.3). From @BotFather. The webhook secret can be any random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# MoneyGram Ramps sandbox (Story 24.4). From MoneyGram's partner portal.
RAMPS_SECRET_KEY=
MONEYGRAM_ENV=sandbox
# The public host MoneyGram signs webhooks for, e.g. happy-otter-123.convex.site
MONEYGRAM_WEBHOOK_HOST=
