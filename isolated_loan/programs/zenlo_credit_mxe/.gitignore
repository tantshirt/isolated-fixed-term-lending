# Circuit build output: only the files the program macros read at compile time are committed
# (tier.arcis, tier.idarc, tier.hash, tier.weight), so `anchor build` works without arcium.
build/*
!build/tier.arcis
!build/tier.idarc
!build/tier.hash
!build/tier.weight
